{
  // Astro builds a fully static site into ./dist, so Workers Static Assets can
  // serve it directly — there is no Worker script and no Astro adapter needed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "josesoares-eng",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html for paths that do not match a built page.
    "not_found_handling": "404-page"
  }
}
