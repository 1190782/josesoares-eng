---
import cv, { type Locale } from "../data/Cv";
import { services, servicesBasePath, type IService } from "../data/Services";
import ui from "../i18n/Ui";

interface Props {
  locale: Locale;
  service: IService;
}

const { locale, service } = Astro.props;
const strings = ui[locale];

const base = servicesBasePath[locale];
const home = locale === "pt" ? "/" : "/en/";
const pageUrl = new URL(`${base}/${service.slug[locale]}/`, Astro.site).href;

const otherServices = services.filter((item) => item.slug.en !== service.slug.en);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.heading[locale],
  description: service.description[locale],
  url: pageUrl,
  serviceType: service.title[locale],
  provider: {
    "@type": "ProfessionalService",
    name: `${cv.name}, ${cv.headline[locale]}`,
    url: cv.website,
    email: cv.email,
    telephone: cv.phone,
    address: { "@type": "PostalAddress", addressLocality: "Porto", addressCountry: "PT" },
  },
  areaServed: [
    { "@type": "City", name: "Porto" },
    { "@type": "AdministrativeArea", name: "Norte, Portugal" },
    { "@type": "Country", name: "Portugal" },
  ],
  availableLanguage: [
    { "@type": "Language", name: "Portuguese", alternateName: "pt" },
    { "@type": "Language", name: "English", alternateName: "en" },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: strings.homeIncludes,
    itemListElement: service.includes.map((item) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: item[locale] },
    })),
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question[locale],
    acceptedAnswer: { "@type": "Answer", text: faq.answer[locale] },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: strings.breadcrumbHome,
      item: new URL(home, Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: strings.navServices,
      item: new URL(`${home}#servicos`, Astro.site).href,
    },
    { "@type": "ListItem", position: 3, name: service.title[locale], item: pageUrl },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<section class="border-b-4 border-brass-400 bg-navy-800 text-paper-100">
  <div class="mx-auto max-w-5xl px-6 py-14">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 font-mono text-xs text-navy-300">
        <li><a class="transition hover:text-brass-400" href={home}>{strings.breadcrumbHome}</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a class="transition hover:text-brass-400" href={`${home}#servicos`}>
            {strings.navServices}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-brass-400">{service.title[locale]}</li>
      </ol>
    </nav>

    <h1 class="lockup mt-8 max-w-3xl text-3xl leading-tight text-paper-50 sm:text-4xl">
      {service.heading[locale]}
    </h1>
    <p class="mt-6 max-w-prose text-lg leading-relaxed text-navy-300">
      {service.description[locale]}
    </p>

    <a
      href={`${home}#contacto`}
      class="mt-8 inline-block border border-brass-400 bg-brass-400 px-6 py-3 text-sm font-medium text-navy-900 transition hover:bg-brass-300"
    >
      {strings.serviceCta}
    </a>
  </div>
</section>

<div class="mx-auto max-w-5xl px-6">
  <div class="grid gap-8 py-14 lg:grid-cols-[1.5fr_1fr] lg:items-start">
    <div class="flex flex-col gap-5">
      {
        service.body.map((paragraph) => (
          <p class="max-w-prose text-lg leading-relaxed text-navy-800">{paragraph[locale]}</p>
        ))
      }
    </div>

    <div class="flex flex-col gap-4">
      <div class="border-l-2 border-brass-400 bg-white p-5">
        <p class="eyebrow text-brass-600">{strings.serviceAudience}</p>
        <p class="mt-3 leading-relaxed text-navy-800">{service.audience[locale]}</p>
      </div>

      <div class="border border-paper-200 bg-white p-5">
        <p class="eyebrow text-brass-600">{strings.homeIncludes}</p>
        <ul class="mt-4 flex flex-col gap-3">
          {
            service.includes.map((item) => (
              <li class="flex gap-3 text-sm text-navy-800">
                <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 bg-brass-400" />
                <span>{item[locale]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <section class="border-t border-paper-200 py-14">
    <h2 class="eyebrow text-brass-600">{strings.serviceFaq}</h2>
    <div class="mt-6 flex max-w-3xl flex-col gap-3">
      {
        service.faqs.map((faq) => (
          <details class="group border border-paper-200 bg-white">
            <summary
              class="flex cursor-pointer items-center justify-between gap-4 p-5 font-display text-base font-medium text-navy-900 transition hover:text-brass-600"
            >
              <span>{faq.question[locale]}</span>
              <span
                aria-hidden="true"
                class="shrink-0 font-mono text-brass-600 transition group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="border-t border-paper-100 px-5 py-5 leading-relaxed text-navy-800">
              {faq.answer[locale]}
            </p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="border-t border-paper-200 py-14">
    <h2 class="eyebrow text-brass-600">{strings.serviceOthers}</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        otherServices.map((item) => (
          <a
            href={`${base}/${item.slug[locale]}/`}
            class="group flex flex-col border border-paper-200 bg-white p-5 transition hover:border-brass-400"
          >
            <p class="font-display text-base font-medium text-navy-900">{item.title[locale]}</p>
            <p class="mt-2 grow text-sm leading-relaxed text-navy-500">
              {item.description[locale]}
            </p>
            <span class="eyebrow mt-4 text-brass-600">{strings.serviceLearnMore}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-t border-paper-200 py-14">
    <div class="border border-brass-400 bg-white p-8">
      <h2 class="font-display text-2xl font-medium text-navy-900">{strings.contactHeading}</h2>
      <p class="mt-3 max-w-prose text-navy-800">{strings.contactLead}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={`${home}#contacto`}
          class="border border-brass-400 bg-brass-400 px-6 py-3 text-sm font-medium text-navy-900 transition hover:bg-brass-300"
        >
          {strings.serviceCta}
        </a>
        <a
          class="font-mono text-sm break-all text-navy-900 underline decoration-brass-400 underline-offset-4"
          href={`mailto:${cv.email}`}
        >
          {cv.email}
        </a>
      </div>
    </div>
  </section>
</div>
