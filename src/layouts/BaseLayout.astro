---
import cv, { type Locale } from "../data/Cv";
import { legalIdentity } from "../data/Legal";
import ui from "../i18n/Ui";
import "../styles/global.css";

// Astro resolves component props from a type named `Props`.
interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page in the current locale, e.g. "/cv". */
  path: string;
  /** Path of the same page in the other locale, e.g. "/en/cv". */
  alternatePath: string;
}

const { locale, title, description, path, alternatePath } = Astro.props;

const strings = ui[locale];
const canonical = new URL(path, Astro.site).href;
const alternate = new URL(alternatePath, Astro.site).href;
const otherLocale: Locale = locale === "pt" ? "en" : "pt";
const htmlLang = locale === "pt" ? "pt-PT" : "en";
const hreflang = locale === "pt" ? "pt-PT" : "en";
const otherHreflang = otherLocale === "pt" ? "pt-PT" : "en";
const home = locale === "pt" ? "/" : "/en/";
const ogImage = new URL("/og-image.png", Astro.site).href;

const navLinks = [
  { label: strings.navServices, href: `${home}#servicos` },
  { label: strings.navExamples, href: `${home}#exemplos` },
  { label: strings.navCv, href: locale === "pt" ? "/cv" : "/en/cv" },
  { label: strings.navContact, href: `${home}#contacto` },
];

const currentYear = new Date().getFullYear();
---

<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang={hreflang} href={canonical} />
    <link rel="alternate" hreflang={otherHreflang} href={alternate} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(path.replace(/^\/en/, "") || "/", Astro.site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={cv.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "pt" ? "pt_PT" : "en_GB"} />
    <meta property="og:locale:alternate" content={locale === "pt" ? "en_GB" : "pt_PT"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${cv.name}, ${cv.headline[locale]}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#24323f" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Fonts are served from this domain, so no visitor data reaches a third
        party to render text. These two carry the first paint. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/Jost-latin-92zatBhPNqw73oTd4g.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/IBMPlexSans-latin-zYXzKVElMYYaJe8bpLHnCwDKr932-G7dytD-Dmu1syxeKYY.woff2"
    />
  </head>

  <body>
    <a
      href="#main"
      class="print-hide sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-brass-400 focus:px-4 focus:py-2 focus:text-navy-900"
    >
      {strings.skipToContent}
    </a>

    <header class="print-hide border-b border-navy-700 bg-navy-800 text-paper-100">
      <nav
        class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-3 px-6 py-5"
        aria-label={strings.mainNavLabel}
      >
        <a href={home} class="lockup text-sm text-paper-50">{strings.siteName}</a>

        <div class="ml-auto flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
          {
            navLinks.map((link) => (
              <a href={link.href} class="text-paper-100 transition hover:text-brass-400">
                {link.label}
              </a>
            ))
          }
          <a
            href={alternatePath}
            class="eyebrow text-navy-300 transition hover:text-paper-50"
            hreflang={otherHreflang}
          >
            {strings.cvOtherLanguage}
          </a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="print-hide border-t-4 border-brass-400 bg-navy-800 text-paper-100">
      <div
        class="mx-auto flex max-w-5xl flex-wrap items-end justify-between gap-x-8 gap-y-6 px-6 py-12"
      >
        <div>
          <p class="lockup text-sm text-paper-50">{strings.siteName}</p>
          <p class="lockup mt-2 text-xs text-brass-400">{strings.siteTagline}</p>
          <p class="mt-4 text-sm text-navy-300">{cv.location[locale]}</p>
        </div>

        <ul class="flex flex-col gap-2 font-mono text-xs">
          <li>
            <a class="text-paper-100 transition hover:text-brass-300" href={`mailto:${cv.email}`}>
              {cv.email}
            </a>
          </li>
          <li>
            <a
              class="text-paper-100 transition hover:text-brass-300"
              href={`tel:${cv.phone.replace(/\s/g, "")}`}
            >
              {cv.phone}
            </a>
          </li>
          <li>
            <a
              class="text-paper-100 transition hover:text-brass-300"
              href={cv.linkedin}
              rel="me noopener"
              target="_blank"
            >
              linkedin.com/in/jose-soares-it
            </a>
          </li>
        </ul>

        <ul class="flex flex-col gap-2 font-mono text-xs">
          <li>
            <a
              class="text-paper-100 transition hover:text-brass-300"
              href={locale === "pt" ? "/privacidade" : "/en/privacy"}
            >
              {strings.navPrivacy}
            </a>
          </li>
          <li>
            <a
              class="text-paper-100 transition hover:text-brass-300"
              href={locale === "pt" ? "/termos" : "/en/terms"}
            >
              {strings.navTerms}
            </a>
          </li>
          {
            legalIdentity.hasRegisteredActivity && (
              <li>
                <a
                  class="text-paper-100 transition hover:text-brass-300"
                  href={legalIdentity.complaintsBookUrl}
                  rel="noopener"
                  target="_blank"
                >
                  {strings.footerComplaintsBook}
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <div class="border-t border-navy-700">
        <div
          class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-8 gap-y-2 px-6 py-6 font-mono text-xs text-navy-300"
        >
          <p>© {currentYear} {legalIdentity.name}</p>
          <p>
            {legalIdentity.name}
            {legalIdentity.taxNumber.startsWith("PENDING") ? "" : ` · NIF ${legalIdentity.taxNumber}`}
            {legalIdentity.address.startsWith("PENDING") ? "" : ` · ${legalIdentity.address}`}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
