---
import HomeDocument from "../../components/HomeDocument.astro";
import ui from "../../i18n/Ui";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale = "en" as const;
const strings = ui[locale];
---

<BaseLayout
  locale={locale}
  title={`${strings.homeTitle} | ${strings.siteName}`}
  description={strings.homeMetaDescription}
  path="/en/"
  alternatePath="/"
>
  <HomeDocument locale={locale} />
</BaseLayout>
