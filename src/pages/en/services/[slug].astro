---
import type { GetStaticPaths } from "astro";

import ServiceDocument from "../../../components/ServiceDocument.astro";
import ui from "../../../i18n/Ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { services } from "../../../data/Services";

export const getStaticPaths = (() => {
  return services.map((service) => ({
    params: { slug: service.slug.en },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const locale = "en" as const;
const strings = ui[locale];
const { service } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={`${service.heading[locale]} | ${strings.siteName}, Porto`}
  description={service.description[locale]}
  path={`/en/services/${service.slug.en}/`}
  alternatePath={`/servicos/${service.slug.pt}/`}
>
  <ServiceDocument locale={locale} service={service} />
</BaseLayout>
