---
import LegalDocument from "../components/LegalDocument.astro";
import { termsPage } from "../data/Legal";
import ui from "../i18n/Ui";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = "pt" as const;
const strings = ui[locale];
const page = termsPage;
---

<BaseLayout
  locale={locale}
  title={`${page.title[locale]} | ${strings.siteName}`}
  description={page.metaDescription[locale]}
  path="/termos"
  alternatePath="/en/terms"
>
  <LegalDocument locale={locale} page={page} />
</BaseLayout>
